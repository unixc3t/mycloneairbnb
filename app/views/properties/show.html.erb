<div class="property_detail">
  <div class="title_detail">
    <h1>
      <%= @property.name %>-<%= @property.city%>
    </h1>
    <div>
      <div>
        <i>分享</i>
      </div>
      <div data-controller="wishlist" data-user-id="<%= current_user&.id %>" data-property-id="<%= @property.id %>"
        data-user-logged-in="<%= user_signed_in? %>"
        data-wishlist-id="<%= @property.wishlists.find_by(user: current_user)&.id %>"
        data-action="click->wishlist#updateWishlistStatus" data-status="<%= @property.wishlisted_by?(current_user) %>">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
          class="size-6 <%= @property.wishlisted_by?(current_user) ? 'fill-red-500' : 'fill-none' %>">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"
            data-wishlist-target="icon" 
            />
        </svg>
        <i data-wishlist-target="text">
          <%= @property.wishlisted_by?(current_user)? '已收藏' : '收藏' %>
        </i>
      </div>
    </div>
  </div>
  <div class="img-detail">
    <div class="pic1">
      <%= image_tag("pic1.jpeg") %>
    </div>
    <div class="pic2">
      <%= image_tag("pic2.jpeg") %>
    </div>
    <div class="pic3">
      <%= image_tag("pic3.jpeg") %>
    </div>
    <div class="pic4">
      <%= image_tag("pic4.jpeg") %>
    </div>
    <div class="pic5">
      <%= image_tag("pic5.jpeg") %>
    </div>
  </div>
  <div class="info-detail">
    <div class="info-left">
      <div class="info-detail-1">
        <div class="info-title">
          <h1>法国法兰西岛巴黎的酒店</h1>
          <span>评分:4.61 215 条评价</span>
        </div>
        <div class="info-more">
          <p>
            这家酒店位于歌剧院区的传统奥斯曼建筑内，仍然保留着18世纪的风格，设有温馨的木板大堂、书柜和落地式大摆钟。
          </p>
        </div>
      </div>
      <div class="info-detail-2">
        <div class="info-list">
          <div>
            <a href="" aria-label="tdfdfdfdfdfeste">
              <%= image_tag("map1.jpg") %>
                <div>
                  <h1>距离奥斯班百货地o址</h1>
                  <p>轻松前往这家标志性的美好时代（Belle Époque）百货商店，那里有3,500多个品牌。</p>
                </div>
            </a>
          </div>

          <div class="no-link">
            <%= image_tag("map2.png") %>
              <div>
                <h1>距离奥斯班百货地o址</h1>
                <p>轻松前往这家标志性的美好时代（Belle Époque）百货商店，那里有3,500多个品牌。</p>
              </div>
          </div>


          <div class="no-link">
            <%= image_tag("map3.png") %>
              <div>
                <h1>距离奥斯班百货地o址</h1>
                <p>轻松前往这家标志性的美好时代（Belle Époque）百货商店，那里有3,500多个品牌。</p>
              </div>
          </div>
        </div>
      </div>
    </div>

    <div class="info-right">
      <div class="info-r-up">
        获得#837爱彼得基金w会
      </div>
      <div class="info-r-down">
        <div id="cost">
          <i>低至343元</i><span>/2晚</span>
        </div>
        <div class="date-choice">
          <div class="checkin">
            <h1>入住日期</h1>
          </div>
          <div class="outdate">
            <h1>退房日期</h1>
          </div>
          <div class="number">
            <h1>房客</h1>
          </div>
        </div>
        <div class="select-house-div">
          <button class="select-house">选择房间</button>
        </div>
        <div id="cost-info">
          <span>
            您现在不会被收费
          </span>
        </div>
      </div>
    </div>
  </div>
</div>