<!-- Slider main container -->

<div id="property_list">
    <% @properties.each do |property| %>
        <div class="property_div">
            <%= link_to property_path(property.id) do %>
            <div class="property_img relative cursor-pointer">

                <div class="swiper myswiper">
                    <!-- Additional required wrapper -->
                    <div class="swiper-wrapper cursor-pointer">
                        <!-- Slides -->
                        <% property.images.each do |image| %>
                                <%= image_tag image, class: "swiper-slide" %>
                            <% end %>
                    </div>
                    <!-- If we need navigation buttons -->
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
                    <!-- If we need pagination -->
                    <div class="swiper-pagination"></div>

                </div>
                <div class="absolute z-10 right-5 top-5">
                    <svg xmlns="http://www.w3.org/2000/svg"  viewBox="0 0 24 24" strokeWidth={1.5}
                        stroke="currentColor" className="size-6"
                        class="block h-8 w-8 stroke-white stroke-2 <%= property.wishlisted_by?(current_user) ? 'fill-red-500' : 'fill-none' %>"
                        data-controller="wishlist" data-user-id="<%= current_user&.id %>"
                        data-property-id="<%= property.id %>" data-user-logged-in="<%= user_signed_in? %>"
                        data-wishlist-id="<%= property.wishlists.find_by(user: current_user)&.id %>"
                        data-action="click->wishlist#updateWishlistStatus"
                        data-status="<%= property.wishlisted_by?(current_user) %>">
                        <path strokeLinecap="round" strokeLinejoin="round"
                            d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                    </svg>

                </div>
            </div>


            <div class="property-title">
                <h3>
                    <%= property.name %>
                </h3>
            </div>
            <div class="property-rating">
                <span>评分:<%= property.average_final_rating.round(2) %></span>
            </div>
            <div class="property-info">
                <ul>
                    <li>
                        <%= property.available_dates %>
                    </li>
                    <li>this info</li>
                    <li>this info</li>
                    <li>
                        <%= humanized_money_with_symbol(property.price) %>
                    </li>
                </ul>
            </div>
            <% end %>
        </div>
        <% end %>
</div>